# ---- AI provider ----
# The server auto-selects a provider based on which key is set.
# Preference: Gemini (free) first, then Anthropic. Force one with AI_PROVIDER.
# AI_PROVIDER=gemini | anthropic   (optional)
AI_PROVIDER=

# Google Gemini (free tier). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash   (optional override)

# Anthropic (Claude). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# If NEITHER key is set, the server runs in MOCK mode (no real AI calls).

# Port the server listens on
PORT=3001

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173
